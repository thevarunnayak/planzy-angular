# Planzy Appwrite Environment Configuration
# Copy this file to .env.local and populate with your Appwrite Cloud project credentials

# Use your exact Regional API Endpoint from Appwrite Console -> Project Settings
# Example (Singapore): https://sgp.cloud.appwrite.io/v1
# Example (Frankfurt): https://fra.cloud.appwrite.io/v1
# Example (Default Global): https://cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id_here
APPWRITE_DATABASE_ID=planzy_db
