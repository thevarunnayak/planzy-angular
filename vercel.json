{
  "version": 2,
  "builds": [
    {
      "src": "api/appwrite/[...path].js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/planzy-angular/browser"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/appwrite/(.*)",
      "dest": "/api/appwrite/[...path].js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
